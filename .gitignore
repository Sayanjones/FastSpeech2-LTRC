# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# Virtual environments
venv/
env/
ENV/
.venv/

# Jupyter / Colab
.ipynb_checkpoints/

# Raw and preprocessed dataset directories
data/
raw_data/
preprocessed_data/
mfa_corpus/
TextGrid/

