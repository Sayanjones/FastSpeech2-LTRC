English/checkpoints/*.pth.tar
Telugu/checkpoints/*.pth.tar
!English/checkpoints/.gitkeep
!Telugu/checkpoints/.gitkeep

# Tensorboard raw event logs (optional: large event buffers)
*.tfevents.*

# OS generated files
.DS_Store
Thumbs.db
desktop.ini

# LaTeX build artifacts
Report/*.aux
Report/*.log
Report/*.out
Report/*.toc
Report/*.synctex.gz
